{
  "manifest_version": 3,
  "name": "Phoenix Pilot",
  "version": "2.1.0",
  "description": "AI-powered LinkedIn and Gmail message assistant for job seekers. Generate tailored replies using your Phoenix sessions.",
  "homepage_url": "https://arashbehmand.github.io/phoenix-pilot",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://mail.google.com/*",
    "https://api.phoenix0.online/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/content/index.tsx"],
      "css": [],
      "all_frames": true
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content-gmail/index.tsx"],
      "css": [],
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "privacy_policy_url": "https://arashbehmand.github.io/phoenix-pilot/#/privacy",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Phoenix Pilot",
    "default_popup": "popup.html"
  }
}
